# Copy to .env.local and fill in. Never commit real values.
# Until the Supabase and Resend values are set, forms run in demo mode.

NEXT_PUBLIC_SITE_URL=

# Supabase (server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (server only)
RESEND_API_KEY=
EMAIL_FROM=
APPLICATIONS_NOTIFY_TO=
ENQUIRIES_NOTIFY_TO=

# Verifies the Supabase status-change webhook
WEBHOOK_SECRET=

# Minimum applicant age. Leave empty for no restriction; set to 18 once confirmed.
MIN_APPLICANT_AGE=
